# Host settings for camera-ingest on macOS. Copy to .env.host; do not commit it.
DATABASE_URL=postgresql+psycopg://surveillance:change-me@localhost:5432/surveillance
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=surveillance_events_labse_v1
QDRANT_TIMEOUT_SECONDS=10
EMBEDDING_MODEL=sentence-transformers/LaBSE
CAMERA_DEVICE_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
PREVIEW_JPEG_QUALITY=80
YOLO_DEVICE=mps
MODEL_REGISTRY_DIR="/Users/stanislav/Library/Application Support/CV DATA/model-registry"
YOLO_MODEL_PATH="/Users/stanislav/Library/Application Support/CV DATA/model-registry/yolo26n/8.4.0/yolo26n.pt"
YOLO_MODEL_MANIFEST=models/manifest/yolo26n.json
YOLO_CONFIDENCE_THRESHOLD=0.45
# Empty means every COCO class supported by YOLO26n.
YOLO_CLASSES=
TRACKER_CONFIG=src/surveillance/camera/bytetrack.yaml
TRACKER_ID_RESET_MISSING_FRAMES=15
TRACKER_ID_IOU_THRESHOLD=0.5
EVENT_MIN_TRACK_AGE_SECONDS=2
EVENT_COOLDOWN_SECONDS=20
OLLAMA_HOST=http://127.0.0.1:11434
POSTGRES_READER_PASSWORD=replace-with-reader-secret
ANALYTICS_DATABASE_URL=postgresql+psycopg://surveillance_reader:replace-with-reader-secret@localhost:5432/surveillance
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_NUM_CTX=4096
VISION_PROMPT_VERSION=visible-facts-ru-v1
VISION_BACKEND=mlx
MLX_PYTHON_PATH=.venv-mlx/bin/python
MLX_MODEL_PATH="/Users/stanislav/Library/Application Support/CV DATA/model-registry/mlx-community/Qwen2.5-VL-3B-Instruct-4bit"
MLX_MAX_TOKENS=100
# Local checksum-verified draft: shadow tasks only, never autonomous actions.
DANGER_MODEL_PATH="/Users/stanislav/Library/Application Support/CV DATA/model-registry/danger-mlp/uca-ru-draft-v1/danger_mlp.pt"
DANGER_MODEL_MANIFEST="/Users/stanislav/Library/Application Support/CV DATA/model-registry/danger-mlp/uca-ru-draft-v1/manifest.json"
DANGER_MODEL_CARD="/Users/stanislav/Library/Application Support/CV DATA/model-registry/danger-mlp/uca-ru-draft-v1/model_card.md"
DANGER_EMBEDDING_MODEL=sentence-transformers/LaBSE
DANGER_ALLOW_LOCAL_DRAFT=true
ANALYSIS_POLL_SECONDS=1
ANALYSIS_MAX_ATTEMPTS=3
