DATABASE_URL=postgresql+psycopg://surveillance:change-me@postgres:5432/surveillance
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=surveillance_events_labse_v1
QDRANT_TIMEOUT_SECONDS=10
QUERY_STREAM_MAX_LENGTH=1000
QUERY_RESULT_TTL_SECONDS=120
QUERY_API_WAIT_SECONDS=60
QUERY_VECTOR_TOP_K=10
QUERY_VECTOR_MAX_TOP_K=20
QUERY_VECTOR_TIMEOUT_SECONDS=3
QUERY_SQL_TIMEOUT_MS=3000
QUERY_LIST_LIMIT=100
QUERY_MAX_RANGE_DAYS=31
QUERY_TIMEZONE=Europe/Moscow
QUERY_OLLAMA_INTENT_TIMEOUT_SECONDS=25
QUERY_OLLAMA_SUMMARY_TIMEOUT_SECONDS=30
AUTH_SESSION_COOKIE_NAME=surveillance_session
AUTH_SESSION_HOURS=4
AUTH_IDLE_MINUTES=15
# Set true only behind HTTPS/TLS.
AUTH_COOKIE_SECURE=false
EMBEDDING_MODEL=sentence-transformers/LaBSE
DANGER_ALLOW_LOCAL_DRAFT=false
CAMERA_DEVICE_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
PREVIEW_JPEG_QUALITY=80
PREVIEW_INTERVAL_SECONDS=0.2
MODEL_REGISTRY_DIR=/opt/cv-data/model-registry
YOLO_MODEL_PATH=/opt/cv-data/model-registry/yolo26n/8.4.0/yolo26n.pt
YOLO_MODEL_MANIFEST=models/manifest/yolo26n.json
YOLO_DEVICE=cpu
YOLO_CONFIDENCE_THRESHOLD=0.45
YOLO_CLASSES=
TRACKER_CONFIG=src/surveillance/camera/bytetrack.yaml
EVENT_MIN_TRACK_AGE_SECONDS=2
EVENT_PRESENCE_TIMEOUT_SECONDS=20
OUTBOX_PROCESSING_TIMEOUT_SECONDS=300
